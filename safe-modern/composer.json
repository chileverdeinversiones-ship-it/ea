{
  "name": "chileverdeinversiones/safe-modern",
  "description": "Nueva aplicación financiera para cooperativa de ahorro y crédito en Guatemala",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "SafeModern\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SafeModern\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit"
  },
  "config": {
    "sort-packages": true,
    "platform-check": true
  }
}
